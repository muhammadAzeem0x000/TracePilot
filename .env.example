# Backend only. Use a service-role key and never expose it through NEXT_PUBLIC_*.
SUPABASE_URL=https://aylkqcuojtrdvpliqzso.supabase.co
SUPABASE_KEY=your-service-role-key
CORS_ORIGINS=http://localhost:3000
APP_ENVIRONMENT=development
PUBLIC_DEMO_MODE=false
ALLOW_ANONYMOUS_PRODUCTION_WRITES=false
GITHUB_TOKEN=your-read-only-github-token
GITHUB_API_URL=https://api.github.com
LLM_API_KEY=your-openai-compatible-api-key
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_PROVIDER_NAME=deepseek
# Optional transient-failure fallback; configure all three values or none.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_PROVIDER_NAME=fallback
# Optional trusted pricing registry. Unknown/unconfigured cost remains null.
# AI_PRICING_JSON={"model":{"input_usd_per_million_tokens":0,"output_usd_per_million_tokens":0}}
AI_PRICING_SOURCE_DATE=
MAX_TOOL_CALLS=6
FINAL_OUTPUT_RETRIES=1
EMBEDDING_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
KNOWLEDGE_CHUNK_MAX_TOKENS=350
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=50
KNOWLEDGE_CONTEXT_BUDGET_TOKENS=1800
KNOWLEDGE_CANDIDATE_LIMIT=12
KNOWLEDGE_RERANK_ENABLED=true
INVESTIGATION_WORKER_ENABLED=true
INVESTIGATION_WORKER_POLL_SECONDS=1.0
INVESTIGATION_JOB_LEASE_SECONDS=240
INVESTIGATION_JOB_MAX_ATTEMPTS=3
INVESTIGATION_RETRY_BASE_SECONDS=5

# Browser-visible URL of the FastAPI service.
NEXT_PUBLIC_API_URL=http://localhost:8000
